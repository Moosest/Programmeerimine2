@page "/create"
@page "/edit/{Id:int}"

@inject KooliProjekt.BlazorWasm.IApiClient apiClient
@inject NavigationManager NavManager

<PageTitle>@title client</PageTitle>

<h3>@title client</h3>

<EditForm EditContext="editContext" OnSubmit="@FormSubmitted">
    <DataAnnotationsValidator />
    <ValidationSummary />
    <p class="alert-danger">@error</p>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">ID</label>
        <div class="col-sm-10">
            @client.Id
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Name</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="client.Name" />
            <ValidationMessage For="@(() => client.Name)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Email</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="client.Email" />
            <ValidationMessage For="@(() => client.Email)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Phone</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="client.Phone" />
            <ValidationMessage For="@(() => client.Phone)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Address</label>
        <div class="col-sm-10">
            <InputText class="form-control" @bind-Value="client.Address" />
            <ValidationMessage For="@(() => client.Address)" />
        </div>
    </div>
    <div class="form-group row">
        <label class="col-ms-2 col-form-label">Discount (0 - 0.9)</label>
        <div class="col-sm-10">
            <InputNumber class="form-control" step="0.01" @bind-Value="client.Discount" />
            <ValidationMessage For="@(() => client.Discount)" />
        </div>
    </div>

    <div class="form-group row">
        <label class="col-ms-2 col-form-label"></label>
        <div class="col-sm-10 mt-2">
            <button type="submit" class="btn btn-primary">Save</button>
            <a class="btn btn-secondary" href="/clients">Cancel</a>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int Id { get; set; }

    private string error = "";
    private string title = "Edit";
    private EditContext editContext;
    private Client client = new Client();

    private ValidationMessageStore messageStore;

    protected override async Task OnInitializedAsync()
    {
        editContext = new EditContext(client);
        messageStore = new ValidationMessageStore(editContext);

        if (Id == 0)
        {
            title = "Add";
            return;
        }

        var response = await apiClient.Get(Id);
        if (response != null && !response.HasErrors && response.Value != null)
        {
            client = response.Value;
            editContext = new EditContext(client);
            messageStore = new ValidationMessageStore(editContext);
            return;
        }

        error = "Klienti ei leitud!";
    }

    private async Task FormSubmitted()
    {
        // Eemalda eelnevad veateated
        error = "";
        messageStore?.Clear();

        OperationResult result;
        try
        {
            result = await apiClient.Save(client);
        }
        catch (HttpRequestException ex)
        {
            error = "Cannot reach the WebAPI: " + ex.Message;
            return;
        }

        if (result != null && !result.HasErrors)
        {
            NavManager.NavigateTo("/clients");
            return;
        }

        if (result == null)
        {
            error = "Viga andmete salvestamisel!";
            return;
        }

        foreach (var apiError in result.Errors)
        {
            messageStore?.Add(new FieldIdentifier(client, string.Empty), apiError);
        }

        foreach (var propertyError in result.PropertyErrors)
        {
            var propertyName = propertyError.Key[0].ToString().ToUpper() + propertyError.Key.Substring(1);
            messageStore?.Add(new FieldIdentifier(client, propertyName), propertyError.Value);
        }

        // Teavita EditForm'i, et vead on muutunud
        editContext?.NotifyValidationStateChanged();
    }
}
